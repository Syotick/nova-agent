    "ai": "^7.0.65",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.0",
    "pinia": "^2.3.1",
    "vue": "^2.7.16",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
