{
  "name": "nova-agent",
  "version": "0.3.0",
  "description": "Nova Agent - a lightweight, self-contained open-source AI agent (Claude Code mini): agent loop, MCP tools, Agent Skills, scheduled tasks, multi-agent management.",

  "type": "module",
  "license": "MIT",
  "author": "Syotick <Syotick@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syotick/nova-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Syotick/nova-agent/issues"
  },
  "homepage": "https://github.com/Syotick/nova-agent",
  "keywords": [
    "ai-agent",
    "mcp",
    "agent-skills",
    "chatgpt",
    "llm",
    "claude-code",
    "react",
    "express"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@playwright/mcp": "^0.0.79",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "^7.0.65",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.31.0",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
